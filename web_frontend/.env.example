# Frontend environment variables
# Copy to .env and adjust values for your environment. Do NOT commit real secrets.

# Public URL config
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000

# Backend/API endpoints
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001
NEXT_PUBLIC_API_BASE=http://localhost:3001

# Websocket URL if applicable
NEXT_PUBLIC_WS_URL=

# Node env flags
NEXT_PUBLIC_NODE_ENV=development
NEXT_PUBLIC_NEXT_TELEMETRY_DISABLED=1
NEXT_PUBLIC_ENABLE_SOURCE_MAPS=0
NEXT_PUBLIC_PORT=3000
NEXT_PUBLIC_TRUST_PROXY=1
NEXT_PUBLIC_LOG_LEVEL=info
NEXT_PUBLIC_HEALTHCHECK_PATH=/healthz
NEXT_PUBLIC_FEATURE_FLAGS=
NEXT_PUBLIC_EXPERIMENTS_ENABLED=0

# Allow the IDE preview host to embed this app in an iframe.
# Provide one or more space or comma separated origins.
# Examples:
# NEXT_PUBLIC_PREVIEW_IFRAME_ANCESTOR="https://vscode-internal-*.cloud.kavia.ai"
# NEXT_PUBLIC_PREVIEW_IFRAME_ANCESTOR="https://preview.example.com https://*.mycompany.internal"
NEXT_PUBLIC_PREVIEW_IFRAME_ANCESTOR=
