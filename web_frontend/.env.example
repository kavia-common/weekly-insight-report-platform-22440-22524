# Frontend (.env) - set NEXT_PUBLIC_* vars only
# The frontend never hardcodes localhost; all backend requests and SSO links derive from the below.
# Copy this file to .env.local for local dev and adjust values.

# Base backend URL (e.g., http://localhost:3001)
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001

# Optional override for API base URL (if different from backend)
# NEXT_PUBLIC_API_BASE=https://api.example.com

# Fully-qualified frontend URL (used for constructing return links)
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000

# Optional WebSocket base URL
# NEXT_PUBLIC_WS_URL=ws://localhost:3001

# Environment and logging
NEXT_PUBLIC_NODE_ENV=development
# NEXT_PUBLIC_LOG_LEVEL=info

# Enable mock auth login UI (requires backend MOCK_AUTH=true)
NEXT_PUBLIC_MOCK_AUTH=true
